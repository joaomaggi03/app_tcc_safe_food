# Copie este arquivo para .env.local (que fica fora do git) e preencha
# com os dados do SEU projeto no Supabase: Project Settings > API.
#
# Sem estas duas linhas, o app funciona inteiro, só sem o backup (RF01).
# Depois de criar ou mudar o .env.local, reinicie o Metro (npx expo start -c).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key
